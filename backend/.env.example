APP_ENV=development
APP_PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hirescope
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_SSLMODE=disable

# Authentication
JWT_SECRET=replace_with_a_secure_random_key_at_least_32_chars
JWT_EXPIRATION_HOURS=24

# File Upload Storage
CV_STORAGE_DIR=./storage/cv_documents

# Email Service (Step 12B-2)
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_NAME=HireScope
EMAIL_FROM_ADDRESS=recruitment@yourdomain.com
EMAIL_REPLY_TO=recruitment@yourdomain.com
EMAIL_BASE_URL=http://localhost:5173
INTERVIEW_REMINDER_HOURS=24

# External Calendar Integration (Step 12B-3)
# 32-byte hex key for AES-256-GCM token encryption at rest
CALENDAR_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/calendar/google/callback

# Microsoft Outlook / Graph OAuth 2.0
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URL=http://localhost:8080/api/v1/calendar/microsoft/callback
